{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_readonly.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_generated.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_cs.py\"",
            "timeout": 100
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/build_check.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "feature-dev@anthropic-plugin-directory": true,
    "csharp-lsp@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}