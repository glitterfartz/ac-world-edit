<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="DBCD" Version="2.3.1" />
    <Compile Remove="Tests/**/*.cs;Foundation/**/*.cs;artifacts/**/*.cs;Data/WoWDBDefs/**/*.cs;**/bin/**/*.cs;**/obj/**/*.cs" />
    <ProjectReference Include="Foundation/ACWorldEdit.Foundation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Retail table layouts (WoWDBDefs, CC BY-SA 4.0) and the native CASC reader (CascLib, MIT, see Tools/get_casclib.py). -->
    <None Include="Data/WoWDBDefs/definitions/*.dbd;Data/WoWDBDefs/LICENSE.md" Link="definitions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native/win-x64/CascLib.dll" Link="CascLib.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native/win-x64/CascLib.dll')" />
  </ItemGroup>
</Project>
