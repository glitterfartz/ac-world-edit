<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native CascLib file Tools/setup.py builds for this host; it matches CascNative.FileName. -->
    <AcwNativeFolder Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</AcwNativeFolder>
    <AcwNativeFolder Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">linux-arm64</AcwNativeFolder>
    <AcwNativeFolder Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' != 'Arm64'">linux-x64</AcwNativeFolder>
    <AcwCascLib Condition="'$(AcwNativeFolder)' == 'win-x64'">CascLib.dll</AcwCascLib>
    <AcwCascLib Condition="'$(AcwNativeFolder)' == 'linux-x64' or '$(AcwNativeFolder)' == 'linux-arm64'">libCascLib.so</AcwCascLib>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="DBCD" Version="2.3.1" />
    <Compile Remove="Tests/**/*.cs;Foundation/**/*.cs;src/**/*.cs;Scripts/Assets/**/*.cs;Scripts/Viewer/Session/ClientServices*.cs;artifacts/**/*.cs;Data/WoWDBDefs/**/*.cs;ThirdParty/**;**/bin/**/*.cs;**/obj/**/*.cs" />
    <ProjectReference Include="Foundation/ACWorldEdit.Foundation.csproj" />
    <ProjectReference Include="src/ACWorldEdit.ClientData/ACWorldEdit.ClientData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Retail table layouts (WoWDBDefs, CC BY-SA 4.0) and the native CASC reader (CascLib, MIT). Both come from pinned submodules; python Tools/setup.py builds CascLib. -->
    <None Include="Data/WoWDBDefs/definitions/*.dbd" Link="definitions/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data/WoWDBDefs/LICENSE.md" Link="definitions/LICENSE.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data/WoWDBDefs/LICENSE.md')" />
    <None Include="native/$(AcwNativeFolder)/$(AcwCascLib)" Link="$(AcwCascLib)" CopyToOutputDirectory="PreserveNewest" Condition="'$(AcwCascLib)' != '' and Exists('native/$(AcwNativeFolder)/$(AcwCascLib)')" />
    <None Include="native/$(AcwNativeFolder)/CascLib.LICENSE.txt" Link="CascLib.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Condition="'$(AcwCascLib)' != '' and Exists('native/$(AcwNativeFolder)/CascLib.LICENSE.txt')" />
    <None Include="LICENSE;THIRD-PARTY.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The copies above are conditional so a build never fails on them; this says what is missing instead, in the build log CI reads. -->
  <Target Name="WarnMissingDependencies" BeforeTargets="BeforeBuild">
    <Warning Condition="'$(AcwCascLib)' != '' and !Exists('$(MSBuildProjectDirectory)/native/$(AcwNativeFolder)/$(AcwCascLib)')" Code="ACW001" Text="native/$(AcwNativeFolder)/$(AcwCascLib) is missing, so the Retail profile cannot load. Run python Tools/setup.py." />
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)/Data/WoWDBDefs/definitions/Map.dbd')" Code="ACW002" Text="Data/WoWDBDefs is not initialised, so Retail table definitions are missing. Run python Tools/setup.py." />
  </Target>
</Project>
