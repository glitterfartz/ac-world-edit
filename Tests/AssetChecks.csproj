<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Scripts/Assets/*.cs" Link="Assets/%(Filename)%(Extension)" />
    <Compile Include="../Scripts/Data/*.cs" Link="Data/%(Filename)%(Extension)" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <ProjectReference Include="../Foundation/ACWorldEdit.Foundation.csproj" />
  </ItemGroup>
</Project>
