}
client_sun_disc={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
client_sun_dir={
"type": "vec3",
"value": Vector3(0.423999, -0.847998, 0.317999)
}
client_sun_ambient={
"type": "vec3",
"value": Vector3(0.25, 0.25, 0.25)
}
client_sun_diffuse={
